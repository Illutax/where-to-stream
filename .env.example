# Copy to .env and fill in. These are consumed by `docker compose` (compose.yml) on the host.
# .env is gitignored — never commit real secrets. Update-and-restart.sh manages DOCKER_IMAGE_TAG.

# --- Image ---
# Docker image tag. Normally written automatically by update-and-restart.sh; set it by hand only
# for a manual `docker compose up`.
DOCKER_IMAGE_TAG=local

# --- Initial admin (seeded on first start, only while the user table is empty) ---
W2S_ADMIN_USER=admin
W2S_ADMIN_PASSWORD=change-me-please

# --- Persistent login ("stay signed in" / remember-me) ---
# Stable secret so remember-me tokens survive restarts. MUST be set for production.
# Generate e.g. with:  openssl rand -hex 32
W2S_REMEMBER_ME_KEY=

# --- Sessions ---
# HTTP session idle timeout. Sessions are persisted in the DB (Spring Session JDBC) and survive
# restarts. Examples: 30m, 2h, 7d
W2S_SESSION_TIMEOUT=30m

# --- Database (MariaDB) ---
# The app and the db container share MARIADB_PASSWORD. The root password is only used by the db
# container's first-time initialisation.
MARIADB_PASSWORD=w2s
MARIADB_ROOT_PASSWORD=change-me

# --- Spring profiles ---
# 'mariadb' is the default. Add 'google' to enable Google OIDC login, e.g.  mariadb,google
SPRING_PROFILES_ACTIVE=mariadb

# --- Google OIDC login (only needed when the 'google' profile is active) ---
# Register this redirect URI with Google: {baseUrl}/login/oauth2/code/google
#   e.g. https://your-host/w2s/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="013-user-grid-view-prefs" author="vdobler">
        <comment>
            Per-user library view mode (default GRID — the poster-tile grid, opt-out to LIST) and
            tiles-per-row (default 6). Mirrors 007-user-theme / 010-user-age-ratings.
        </comment>
        <addColumn tableName="app_user">
            <column name="view_mode" type="varchar(8)" defaultValue="GRID">
                <constraints nullable="false"/>
            </column>
            <column name="tiles_per_row" type="int" defaultValueNumeric="6">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
